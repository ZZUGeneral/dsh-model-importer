{
  "name": "dsh-model-importer",
  "version": "0.3.0",
  "description": "Graphical importer for third-party models: connects Alibaba Bailian, SiliconFlow, Tencent Cloud TokenHub and Volcano Ark, then writes the picked models into the profile.",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "PUBLISH.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bailian",
    "dashscope",
    "aliyun",
    "siliconflow",
    "tokenhub",
    "tencent",
    "volcano",
    "ark",
    "doubao",
    "model-import",
    "llm"
  ]
}
